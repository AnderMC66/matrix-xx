app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ── Matrix U ──────────────────────────────────────────────────────────────
# Configuración local con las claves de Supabase. La publishable es pública
# por diseño, pero el archivo no se versiona para que nadie meta aquí la
# secret key por costumbre. Plantilla: config/dev.ejemplo.json
/config/*.json
!/config/*.ejemplo.json

# No debería existir —lib/config.dart nunca lo lee, y la app no necesita la
# secret key en absoluto— pero si alguien lo vuelve a crear, que nunca entre
# a git: es el directorio que Gradle empaqueta en el APK.
/android/app/.env

# Catálogo copiado del repo web con `node tool/sincronizar-datos.mjs`.
# Su fuente de verdad es MATRIX-U/data/, versionarlo aquí lo duplicaría (5,8 MB)
# y abriría la puerta a que las dos copias se separen.
/assets/datos/

# Salida de `node tool/extraer-formulas.mjs`: 1,4 MB derivados del banco,
# regenerables en un segundo.
/assets/formulas_banco.json

# La firma de release: rutas y contraseñas del almacén de claves. El almacén
# mismo (.jks) tampoco va aquí — se guarda fuera del repo, porque perderlo
# significa no poder actualizar nunca más la app publicada.
/android/key.properties
*.jks
*.keystore

# Enlaces simbolicos que crea `npx skills` para cada cliente: apuntan a
# .agents/skills con rutas absolutas de esta maquina.
.claude/skills/
